#!/bin/sh
# Two jobs, in order of how much they matter.

# ── 1. Syntax. Blocking. ──
# One trap has cost this project six incidents: a template literal that ends
# early, usually because of a backtick inside a CSS comment. Its worst form
# still parses, so the build stays green and the app renders nothing — the
# error surfaces somewhere unrelated and the search starts in the wrong file.
# Cheap enough to run on every commit, and the one thing worth refusing a
# commit over.
if ! node tools/syntax-guard.mjs; then
  echo
  echo "pre-commit: syntax guard failed. Commit refused."
  echo "Run 'npm run check' to see it again."
  exit 1
fi

# ── 1b. Scope. Blocking. ──
# An identifier with no binding is a runtime error, and nothing before runtime
# looks for one. `tabStyle={cfg.tabStyle}` was pasted into a component with no
# `cfg`: it compiled, it bundled, the syntax guard said clean, the suite passed,
# and it blacked out the app the moment that component rendered.
# Babel's own scope analysis, so it agrees with the bundler.
if ! node tools/scope-guard.mjs; then
  echo
  echo "pre-commit: scope guard failed. Commit refused."
  echo "Every name above has no binding. That is a blank screen at runtime."
  exit 1
fi

# ── 1c. Primitives. Blocking. ──
# A preview screen may not re-implement a class inline. One title bar was
# hand-rolled four times — height, padding, an asymmetric correction, a gap, a
# heavier line — and every value had a class that already answered it.
if ! node tools/primitives-guard.mjs; then
  echo
  echo "pre-commit: primitives guard failed. Commit refused."
  exit 1
fi

# ── 1d. A drifted var() fallback. Blocking. ──
# A fallback is what PAINTS when the token is missing, so one that differs
# from the shipped value states a second design nobody chose. Measured before
# this guard: 19 of them, including --radius-lg at 16px where the token ships
# 8, which is a second corner radius living in the same file as the first.
if ! node apps/web/tools/fallback-drift-guard.mjs; then
  echo
  echo "pre-commit: fallback guard failed. Commit refused."
  exit 1
fi
# ── 1e. A published token nothing reads. Blocking, on a ratchet. ──
# The alert published a border colour for all four variants and no rule
# consumed them, so setting it in the editor changed nothing on screen.
# 362 component tokens are published and 39 are read by nothing. The guard
# stops a NEW one appearing rather than demanding zero, because a number
# that can only fall is a guard somebody keeps.
if ! node apps/web/tools/token-reader-guard.mjs; then
  echo
  echo "pre-commit: token-reader guard failed. Commit refused."
  exit 1
fi

# ── 1g. The chrome's own accent. Blocking. ──
# Nothing guarded this. The a11y audit reads the DOCUMENT's roles, and the
# chrome is a separate class set, so the editor's own accent could fail AA in
# either theme and no run would say so. Five candidate colours were measured
# by hand before this existed.
# It pins the shipped pair to its measured figures, re-derives the light
# ceiling the rule states, asks all 256 of `#FFxx00`, and checks that hue is
# the only thing separating a passing twin from --danger.
if ! node apps/web/tools/chrome-accent-guard.mjs; then
  echo
  echo "pre-commit: chrome accent guard failed. Commit refused."
  exit 1
fi

# A stylesheet is not the whole surface. React reads a bare number in a style
# object as pixels, so `gap: 7` is a 7px gap no CSS file mentions and no CSS
# guard can see. This ran once as a codemod and 650 values had already shipped
# that way. One more arrived in the months it sat unwatched.
if ! node tools/grid-snap.mjs --check; then
  echo
  echo "pre-commit: grid guard failed. Commit refused."
  echo "An inline style length is off the grid. A conditional one is reported"
  echo "and never rewritten, because snapping a branch edits a decision."
  exit 1
fi

# ── 1f. The render checks proven to fire. Blocking, on a ratchet. ──
# The source half asserts every check against a fixture carrying the fault it
# exists to find. The render half had nothing, so a check whose selector stops
# matching goes quiet, and quiet reads exactly like a clean page. 17 of 72 are
# proven. This refuses a record that names a check nobody declares any more, or
# a fixture page that has gone, because the proof came from that page.
if ! node apps/web/tools/render-proof-guard.mjs; then
  echo
  echo "pre-commit: render-proof guard failed. Commit refused."
  echo "Re-measure with 'node apps/web/tools/prove-render.mjs', open"
  echo "/fixtures/prove-render.html and write proveRender() into render-proof.json."
  exit 1
fi

# ── 1g. The SERVED verifier matches the source. Blocking. ──
# public/VERIFY-BROWSER.js is what the matrix driver fetches, and nothing wrote
# it. Every fixture script wrote its own copy under local/fixtures, so that half
# stayed current while the served copy aged. Found 11 September 2026, about to
# run the matrix: the served file was 193,633 bytes holding 74 render checks
# while the source declared 79. A run against it would have measured the old set
# and been labelled with the new one, which is a confident verdict about a check
# set that was never loaded.
if ! node apps/web/tools/write-verifier.mjs --check; then
  echo
  echo "pre-commit: the served verifier has drifted. Commit refused."
  echo "Run 'node apps/web/tools/write-verifier.mjs' to rewrite it."
  exit 1
fi

# ── 2. The build number. Not blocking. ──
# Advanced once per batch of commits, so it counts deploys rather than commits:
# it bumps only when there is nothing unpushed, which means the first commit
# after a push starts a new build and the rest join it.

# Never rewrite the tree mid-merge, rebase or cherry-pick.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
[ -d "$(git rev-parse --git-path rebase-merge)" ] && exit 0
[ -d "$(git rev-parse --git-path rebase-apply)" ] && exit 0

if git rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
  git merge-base --is-ancestor HEAD '@{upstream}' 2>/dev/null || exit 0
fi

# A failure here must not block the commit; a stale number is worth less than
# a lost commit.
node apps/web/scripts/bump-build.mjs >/dev/null 2>&1 || exit 0
git add apps/web/build-number.json
