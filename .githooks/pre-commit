#!/bin/sh
# Advance the build number automatically.
#
# The number lives in a committed file, so if nobody advances it Vercel
# rebuilds and stamps the id it already had — the deploy lands but looks like
# it never happened. Doing it by hand is a step that gets forgotten, so it
# happens here.
#
# The guard keeps the counter meaning what it always meant. It bumps only when
# there is nothing unpushed: the first commit after a push starts a new build,
# and any commits that follow before the next push belong to that same build.
# So the number still counts deploys rather than commits, which is the whole
# reason it stopped being derived from the day's commit count.

# Never rewrite the tree in the middle of a merge, rebase or cherry-pick.
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0
[ -d "$(git rev-parse --git-path rebase-merge)" ] && exit 0
[ -d "$(git rev-parse --git-path rebase-apply)" ] && exit 0

# No upstream yet (fresh clone, detached work) — nothing to compare, so bump.
if git rev-parse -q --verify '@{upstream}' >/dev/null 2>&1; then
  git merge-base --is-ancestor HEAD '@{upstream}' 2>/dev/null || exit 0
fi

# A failure here must not block the commit; a stale number is worth less than
# a lost commit.
node apps/web/scripts/bump-build.mjs >/dev/null 2>&1 || exit 0
git add apps/web/build-number.json
